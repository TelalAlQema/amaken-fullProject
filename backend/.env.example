# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=amaken_realestate
MYSQL_USER=amaken
MYSQL_PASSWORD=amakenpassword

# API Configuration
DATABASE_URL="mysql://amaken:amakenpassword@localhost:3306/amaken_realestate"

# JWT Configuration
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# SMTP Configuration (Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="info@amaken-realestate.com"
SMTP_PASS="your-app-password"
SMTP_FROM="no-reply@amakenrealestate.com"

# Firebase Push Notifications (optional)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
